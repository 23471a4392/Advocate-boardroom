PORT=3000
NODE_ENV=development
DB_PATH=./data/contraboard.sqlite

# AI Provider Keys (Optional: fallback engine will run realistic simulated debates out of the box if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
